# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=pk_v1_your-publishable-key-here
SUPABASE_SERVICE_ROLE_KEY=sk_v1_your-secret-key-here
# Explicit opt-in: the Realtime E2E creates and removes temporary database rows.
SUPABASE_E2E_ENABLED=false

# Stripe
# ─────────────────────────────────────────────────────────────────────────
# Create three least-privilege restricted keys (rk_), one per service boundary.
# They may point to separate test keys with the permissions documented in
# docs/STRIPE.md. Store real values only in local untracked env files or the
# deployment secret store.
STRIPE_PAYMENTS_API_KEY=rk_test_replace_payments
STRIPE_CONNECT_API_KEY=rk_test_replace_connect
STRIPE_OPERATIONS_API_KEY=rk_test_replace_operations
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_replace_me
# Production defaults to disabled when this variable is absent. Enable only
# after the launch reconciliation is green.
STRIPE_CHECKOUT_ENABLED=false
# Optional soft-launch controls. Amount is an integer in euro cents; buyer IDs
# are comma-separated Supabase user UUIDs. Empty values disable each control.
STRIPE_SOFT_LAUNCH_MAX_AMOUNT_MINOR=
STRIPE_SOFT_LAUNCH_BUYER_IDS=
# Keep synchronized with https://stripe.com/files/ips/ips_webhooks.txt.
# Production requests are checked against x-vercel-forwarded-for in addition
# to Stripe signature verification.
STRIPE_WEBHOOK_IP_ALLOWLIST=3.18.12.63,3.130.192.231,13.235.14.237,13.235.122.149,18.211.135.69,35.154.171.200,52.15.183.38,54.88.130.119,54.88.130.237,54.187.174.169,54.187.205.235,54.187.216.72,35.157.207.129,3.69.109.8,3.120.168.93
SUPPORT_EMAIL=support@example.com

# OpenAI (OCR)
OPENAI_API_KEY=

# Resend (Emails)
RESEND_API_KEY=
# Sender used for all transactional emails. Must be a verified domain in Resend
# in production. Use "onboarding@resend.dev" for local/staging if no domain is
# verified yet (capped at 100 emails/day, recipients limited to your Resend
# account email).
RESEND_FROM_EMAIL="PokeMarket <onboarding@resend.dev>"

# Push Notifications (VAPID) — generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# RFC 8292 contact URI used by push services (Apple/Google/Mozilla) to reach
# us if our notifications misbehave. Must be a real mailto: or https:// URI.
VAPID_SUBJECT="mailto:contact@yourdomain.tld"

# Upstash Redis (Rate Limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Sentry
NEXT_PUBLIC_SENTRY_DSN=

# PostHog feature flags (server-side only; EU Cloud host shown)
POSTHOG_PROJECT_KEY=phc_replace_me
POSTHOG_HOST=https://eu.i.posthog.com

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Exact additional origins accepted when building Stripe Checkout redirect URLs.
# Comma-separated; NEXT_PUBLIC_APP_URL and the current VERCEL_URL are automatic.
CHECKOUT_ALLOWED_ORIGINS=
CRON_SECRET=
